module spi(
	input clk,
	input rst,
	input sclk,
	input mosi,
	input ssn,
	output logic [7:0] address,
	output logic [15:0] data,
	output logic read_en,
	output logic write_en,
	output logic tx_req
);
	
	logic shift_en, load_rw, load_addr, load_data_high, load_data_low, rx_finish;
	logic [1:0] s_signal, d_signal, ssn_negedge, sclk_posedge, rw;
	logic [31:0] receive_data_cnt;
	logic [7:0] shift_data;
	
	//ssn_negedge edge_dectector
	always_ff@(posedge clk)
	begin
		if(rst)
		begin
			s_signal <= 1'b0;
			d_signal <= 1'b0;
			ssn_negedge <= 1'b0;
		end
		else
		begin
			{d_signal, s_signal} <= {s_signal, ssn};
			ssn_negedge <= ~s_signal & d_signal;
		end
	end
	
	//sclk_posedge edge_dectector
	always_ff@(posedge clk)
	begin
		if(rst)
		begin
			s_signal <= 1'b0;
			d_signal <= 1'b0;
			sclk_posedge <= 1'b0;
		end
		else
		begin
			{d_signal, s_signal} <= {s_signal, sclk};
			sclk_posedge <= s_signal & ~d_signal;
		end
	end
	
	//cnt
	always_ff@(posedge clk)
	begin
		if(rst)
			receive_data_cnt <= 0;
		else if(sclk_posedge)
			receive_data_cnt <= receive_data_cnt + 1;
	end
	
	//shift_register
	always_ff@(posedge clk)
	begin
		if(rst)
			shift_data <= 0;
		else if(shift_en)
			shift_data <= {shift_data[6:0], mosi};			
	end
	
	//register
	always_ff@(posedge clk)
	begin
		if(rst)
			rw <= 0;
		else if(load_rw)
			rw <= shift_data[0];
	end
	always_comb
	begin
		if(rw)
			read_en = 1;
		else 
			write_en = 1;
	end
	
	always_ff@(posedge clk)
	begin
		if(rst)
			address <= 0;
		else if(load_addr)
			address <= shift_data;
	end
	
	always_ff@(posedge clk)
	begin
		if(rst)
			data <= 0;
		else if(load_data_high)
			data[15:8] <= shift_data;
		else if(load_data_low)
			data[7:0] <= shift_data;
	end
	
	typedef enum {INIT, START_SPI_RX, RECEIVE_ADDRESS, DUMMY
				, CHECK_RW, RECEIVE_DATA, TX_REQ, FINISH, WRITE}state_rx;
	state_rx ps, ns;
	
	always_ff@(posedge clk)
	begin
		if(rst)
			ps <= INIT;
		else 
			ps <= ns;
	end
	
	//FSM
	always_comb
	begin
		shift_en = 0; load_rw = 0; load_addr = 0; load_data_high = 0; 
		load_data_low = 0; ns = ps;
		case(ps)
			INIT:
			begin
				ns = START_SPI_RX;
			end
			START_SPI_RX:
			begin
				if(ssn_negedge)
				begin
					shift_en = 1;
					ns = RECEIVE_ADDRESS;
				end
				else
					ns = START_SPI_RX;
			end
			RECEIVE_ADDRESS:
			begin
				if(receive_data_cnt >= 9)
				begin
					load_addr = 1;
					ns = DUMMY;
				end
				else 
					ns = RECEIVE_ADDRESS;
			end
			DUMMY:
			begin
				if(receive_data_cnt >= 16)
				begin
					shift_en = 1;
					load_rw = 1;
					ns = CHECK_RW;
				end
				else 
					ns = DUMMY;
			end
			CHECK_RW:
			begin
				if(rw)
					ns = TX_REQ;
				else 
					ns = RECEIVE_DATA;
			end
			TX_REQ:
			begin
				ns = FINISH;
			end
			RECEIVE_DATA:
			begin
				if(receive_data_cnt >= 16)
				begin
					shift_en = 1;
					load_data_high = 1;
					ns = WRITE;
				end
				else 
					ns = RECEIVE_DATA;
			end
			WRITE:
			begin
				shift_en = 1;
				load_data_low = 1;
				ns = FINISH;
			end
			FINISH:
			begin
				rx_finish = 1;
				ns = INIT;
			end
		endcase
	end
	
endmodule