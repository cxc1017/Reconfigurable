module encoder
(
	input clk50M,
	input rst,
	input enc,
	output logic [31:0]cnt_meas
);

	logic enc_filter, enc_pos, enable, load;
	logic [31:0] cnt; 

	Low_Pass_Filter_4ENC LowPassFilter0(
		.sig_filter				(enc_filter),	
	    .signal					(enc),	
	    .r_LPF_threshold_enc	(200),
		.clk					(clk50M), 
        .reset                  (rst)
	);
	
	edgeDector edgeDector0(
		.clk			(clk50M),
		.rst			(rst),
	    .enc_filter		(enc_filter),
	    .enc_pos        (enc_pos)
	);
	
	always_ff@(posedge clk50M)
	begin
		if(rst)
			cnt <= 0;
		else if(enable)
			cnt <= cnt + 1;
	end
	
	always_ff@(posedge clk50M)
	begin
		if(!rst)
			cnt_meas <= 0;
		else if(load)
			cnt_meas <= cnt;
	end
	
	typedef enum {Start, Count, Posedge} state_t;
	state_t ps, ns;
	
	always_ff@(posedge clk50M)
	begin
		if(!rst)
			ps <= 0;
		else
			ps <= ns;
	end
	
	always_comb
	begin
		enable = 0; load = 0;
		case(ps)
			Start:
			begin
				ns = Count
			end
			Count:
			begin
				enable = 1;
				ns = Posedge;
			end
			Posedge:
			begin
				load = 1;
				ns = Count;
			end
		endcase
	end
endmodule