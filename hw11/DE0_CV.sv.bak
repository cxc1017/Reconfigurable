	spi_rx spi_rx0(
	.clk				(outclk),
	.rst				(~RESET_N),
	.sclk				(GPIO_0[1]),
	.mosi				(GPIO_0[0]),
	.ssn				(GPIO_0[2]),
	.address			(address),
	.data				(write_data),
