);
	
	//reg_file
	always_ff@(posedge outclk)
	begin
		if(wrreq)			//FIFO
			reg_file[address] <= write_data;
		else if(rdreq)
			read_data <= reg_file[address];
		else if(write_en)	//reg_file
			reg_file[address] <= write_data;
		else if(read_en)
